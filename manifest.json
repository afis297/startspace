{
  "manifest_version": 3,
  "name": "My Free Layout Tab",
  "version": "4.0",
  "description": "Customizable new tab with widgets, weather, todo, timer, currency",
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://api.open-meteo.com/",
    "https://geocoding-api.open-meteo.com/",
    "https://wttr.in/",
    "https://api.openweathermap.org/",
    "https://api.weatherapi.com/",
    "https://api.exchangerate-api.com/"
  ]
}