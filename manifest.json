{
    "manifest_version":  3,
    "name":  "Startspace",
    "version":  "5.0.0",
    "description": "Персональная стартовая страница браузера с виджетами, темами и свободной раскладкой.",
    "chrome_url_overrides":  {
                                 "newtab":  "index.html"
                             },
    "action": {
      "default_title": "Открыть Startspace",
      "default_icon": {
        "16": "assets/icons/icon-16.png",
        "32": "assets/icons/icon-32.png",
        "48": "assets/icons/icon-48.png",
        "128": "assets/icons/icon-128.png"
      }
    },
    "icons": {
      "16": "assets/icons/icon-16.png",
      "32": "assets/icons/icon-32.png",
      "48": "assets/icons/icon-48.png",
      "128": "assets/icons/icon-128.png"
    },
    "background": {
      "service_worker": "src/app/background.js",
      "type": "module"
    },
    "permissions":  [
                        "storage",
                        "tabs",
"scripting",
                        "system.cpu",
                        "system.memory",
                        "system.storage"
                    ],
    "content_security_policy":  {
                                    "extension_pages":  "script-src \u0027self\u0027; object-src \u0027self\u0027;"
                                },
    "optional_host_permissions":  [
                                      "https://api.open-meteo.com/*",
                                      "https://geocoding-api.open-meteo.com/*",
                                      "https://api.exchangerate-api.com/*",
                                      "https://api.mymemory.translated.net/*",
                                      "https://www.youtube.com/*",
                                      "https://www.youtube-nocookie.com/*"
                                  ],
    "content_scripts": [
      {
        "matches": ["\u003call_urls\u003e"],
        "js": ["src/overlay/web-panel.js"],
        "run_at": "document_idle",
        "all_frames": false
      }
    ],
    "web_accessible_resources": [
      { "resources": ["assets/audio/*"], "matches": ["\u003call_urls\u003e"] }
    ]
}